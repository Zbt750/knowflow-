# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
.venv-ragas/
.venv-desktop-build/
venv/

# 环境与密钥：绝不提交；仅保留可公开分享的示例模板
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx

# 前端
node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/
frontend/.vite/
# TypeScript 增量构建产物（由 vue-tsc --build 生成，不应入库）
*.tsbuildinfo
# Playwright 在测试文件旁生成的一次性临时目录
*.tmpdir/

# 运行期数据
storage/
model-settings.bin
model-settings.bin.*.tmp
vision-model-settings.bin
vision-model-settings.bin.*.tmp
.pgdata/
*.kaoyan-backup.zip
desktop-data-backups/
chroma/
# 开发启动脚本写出的日志
.devlogs/

# 真实问答评测、浏览器快照及截图可能含私人资料，仅在本地保留。
# 可公开复现的评测脚本、固定样例和文档仍正常入库。
/eval/reports/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 本地临时测试输出、OCR 中间文件与原卷页面，不进入仓库
/tmp/

# Playwright 根目录临时结果
/test-results/

