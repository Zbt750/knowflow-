      "objective": "在同一知识点内推导并计算反函数二阶导数，检验链式法则的二次使用。",
      "stem": "已知 f(x)=x³+x 在 R 上严格单调、可逆，记 g=f^{-1}。先验证 f′(x)>0，再求 g 在 y=2 处的二阶导数 g″(2)，并说明所用公式中每个量在 x=1 处的取值。",
      "answer": "−3/32。",
      "final_value": "-3/32",
      "solution_steps": [
        "记 g=f^{-1}，g′(y)=1/f′(g(y))。",
        "g″(y)=−f″(g(y))·g′(y)/[f′(g(y))]²。",
        "f′(x)=3x²+1，f″(x)=6x；g(2)=1，f′(1)=4，f″(1)=6。",
        "g′(2)=1/4，故 g″(2)=−6·(1/4)/4²=−6/64=−3/32。"
      ],
      "key_points": [
        "反函数二阶导数公式。",
        "f″ 在 x0=1 处取值。",
        "分母是 f′ 的三次方（等价写法）。"
      ],
      "common_errors": [
        "只对 1/f′ 求导忘记链式因子。",
        "把 f″(1) 算成 6x 在 2 处的值。",
        "符号写成正。"
      ],
      "scope": "数学二·一元函数微分学；f 二阶可导且 f′(1)≠0。",
      "verification": {
        "method": "inverse_second_derivative",
        "result": "PASS",
        "detail": "g″(2)=−f″(1)/(f′(1))³=−6/64=−3/32。"
      }
    },
