      ],
      "objective": "检验 z=x²y+e^{xy} 的偏导与全微分，并在给定点求值。",
      "stem": "设 z=x²y+e^{xy}。\n\n(1) 求 z_x、z_y；(2) 求 dz；(3) 在点 (1,0) 处求 dz。",
      "answer": "z_x=2xy+y e^{xy}，z_y=x²+x e^{xy}；dz=(2xy+y e^{xy})dx+(x²+x e^{xy})dy；在 (1,0) 处 dz=2dy。",
      "final_value": "dz(1,0)=2dy",
      "solution_steps": [
        "对 x 求偏导：z_x=2xy+y e^{xy}。",
        "对 y 求偏导：z_y=x²+x e^{xy}。",
        "全微分 dz=z_x dx+z_y dy。",
        "在 (1,0)：z_x=0+0=0，z_y=1+1=2，故 dz=2dy。"
      ],
      "key_points": [
        "e^{xy} 对 x 求导产生 y 因子，对 y 求导产生 x 因子。",
        "全微分=偏导×微分之和。"
      ],
      "common_errors": [
        "e^{xy} 求导漏乘 y 或 x。",
        "把 z_x 与 z_y 写反。",
        "在 (1,0) 处把 e^0 当成 0。"
      ],
      "scope": "数学二·多元函数微分学；z 在 R² 上可微。",
      "verification": {
        "method": "sympy_diff",
        "result": "PASS",
        "detail": "z_x=2xy+y e^{xy}, z_y=x²+x e^{xy}; at (1,0) dz=2dy。"
      }
    },
