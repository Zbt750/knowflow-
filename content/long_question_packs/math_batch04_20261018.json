      ],
      "objective": "检验 e^x 的三阶麦克劳林近似及拉格朗日余项估误差。",
      "stem": "用 e^x 的三阶麦克劳林公式近似 e^0.1，并估计绝对误差的上界。",
      "answer": "近似 1.1051667；误差上界约 4.6×10⁻⁶。",
      "final_value": "1.1051667",
      "solution_steps": [
        "e^x=1+x+x²/2+x³/6+R₃，R₃=e^ξ x⁴/24，ξ∈(0,x)。",
        "x=0.1：1+0.1+0.005+0.0001666667=1.1051666667。",
        "|R₃|≤e^0.1×(0.1)⁴/24<1.11×10⁻⁴/24≈4.6×10⁻⁶。"
      ],
      "key_points": [
        "三阶泰勒多项式。",
        "拉格朗日余项。",
        "e^0.1<1.11。"
      ],
      "common_errors": [
