        "余项写成 x³。",
        "误差不估上界。"
      ],
      "scope": "数学二·泰勒公式；x=0.1 在 0 的邻域。",
      "verification": {
        "method": "sympy_series",
        "result": "PASS",
        "detail": "三阶近似 1.1051667，误差 <5e-6。"
      }
