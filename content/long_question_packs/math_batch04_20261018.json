      "title": "tan x−sin x 的三阶无穷小",
      "skill_tags": [
        "等价无穷小",
        "泰勒展开"
      ],
      "objective": "在同一知识点内比较 tan x 与 sin x 的三阶项，求差式极限。",
      "stem": "计算 lim_(x→0) (tan x − sin x)/x³，并说明为什么不能用“tan x ~ x、sin x ~ x”直接相减。",
      "answer": "1/2。",
      "final_value": "1/2",
      "solution_steps": [
        "tan x=x+x³/3+o(x³)，sin x=x−x³/6+o(x³)。",
        "两者相减，一次项抵消，三次项为 (1/3+1/6)x³=x³/2。",
        "除以 x³ 得 1/2。",
        "等价无穷小只保留一阶，直接相减会得到 0，丢失三次项信息。"
      ],
      "key_points": [
        "tan x 的三阶项 +x³/3。",
        "sin x 的三阶项 −x³/6。",
        "差式要展开到首个非零项。"
      ],
      "common_errors": [
        "用 x−x=0。",
        "把 tan x 的三阶项符号写错。",
        "只展开到一阶。"
      ],
      "scope": "数学二·极限；x→0，tan x、sin x 可展开。",
      "verification": {
        "method": "sympy_limit",
        "result": "PASS",
        "detail": "limit=1/2。"
      }
