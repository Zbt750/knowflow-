      "title": "二阶齐次方程初值问题的解结构",
      "skill_tags": [
        "解的结构",
        "齐次方程",
        "初值"
      ],
      "objective": "检验 y″−y=0 的通解结构与初值定常数。",
      "stem": "求 y″−y=0 满足 y(0)=1、y′(0)=0 的解，并写出通解结构。",
      "answer": "y=cosh x=(e^x+e^(−x))/2。",
      "final_value": "cosh(x)",
      "solution_steps": [
        "特征方程 r²−1=0，r=±1。",
        "通解 y=C1e^x+C2e^(−x)。",
        "y(0)=C1+C2=1；y′(0)=C1−C2=0，得 C1=C2=1/2。",
        "故 y=(e^x+e^(−x))/2=cosh x。"
      ],
      "key_points": [
        "两个线性无关解 e^x、e^(−x)。",
        "初值定常数。"
      ],
      "common_errors": [
        "通解写成 C e^x。",
        "把 y′(0) 算成 C1+C2。"
      ],
      "scope": "数学二·二阶常系数齐次线性微分方程。",
      "verification": {
        "method": "sympy_dsolve",
        "result": "PASS",
        "detail": "y=cosh x，满足初值。"
      }
    },
