      "title": "秩一矩阵的幂与迹",
      "skill_tags": [
        "矩阵幂",
        "秩一矩阵",
        "特征值"
      ],
      "objective": "在同一知识点内利用秩一矩阵 A=vv^T 的幂公式。",
      "stem": "设 A=[[1,1],[1,1]]。求 A^n，并说明所用公式。",
      "answer": "A^n=2^(n−1)A=[[2^(n−1),2^(n−1)],[2^(n−1),2^(n−1)]]。",
      "final_value": "2^(n-1)*A",
      "solution_steps": [
        "A=vv^T，其中 v=(1,1)^T。",
        "(vv^T)^n=v(v^Tv)^(n−1)v^T，而 v^Tv=2。",
        "故 A^n=2^(n−1)vv^T=2^(n−1)A。"
      ],
      "key_points": [
        "秩一矩阵幂公式。",
        "v^Tv 是标量。"
      ],
      "common_errors": [
        "把 A^n 写成 2^n A。",
        "忘记 n−1 次方。"
      ],
      "scope": "数学二·矩阵幂；n≥1。",
      "verification": {
        "method": "sympy_power",
        "result": "PASS",
        "detail": "A^n=2^(n-1)A。"
      }
    },
