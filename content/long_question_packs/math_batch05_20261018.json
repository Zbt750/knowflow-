      "objective": "检验 y=x³−3x²+2 的凹凸区间与拐点。",
      "stem": "求曲线 y=x³−3x²+2 的拐点，并写出二阶导数、判断其变号、指出凹凸区间。",
      "answer": "拐点 (1,0)；x<1 时 y″<0，曲线为凸；x>1 时 y″>0，曲线为凹。",
      "final_value": "(1,0)",
      "solution_steps": [
        "y′=3x²−6x，y″=6x−6。",
        "y″=0 得 x=1；x<1 时 y″<0，x>1 时 y″>0。",
        "y(1)=1−3+2=0，故拐点 (1,0)。按高数教材定义：y″<0 为凸，y″>0 为凹。"
      ],
      "key_points": [
        "拐点处二阶导数变号。",
        "y″ 符号判断凹凸。"
      ],
      "common_errors": [
        "只看 y″=0 不检查变号。",
        "拐点坐标只写 x=1。"
      ],
      "scope": "数学二·导数应用；三次多项式。",
      "verification": {
        "method": "sympy_diff",
        "result": "PASS",
        "detail": "y″=6x-6，拐点 (1,0)。"
      }
    },
