      "title": "指数函数乘积的拐点与渐近线",
      "skill_tags": [
        "拐点",
        "渐近线",
        "二阶导数"
      ],
      "objective": "在同一知识点内计算 y=xe^(−x) 的拐点与水平渐近线。",
      "stem": "求曲线 y=xe^(−x) 的拐点与水平渐近线，要求写出二阶导数并判断凹凸性。",
      "answer": "拐点 (2,2e^(−2))；x→+∞ 时 y→0，水平渐近线 y=0。",
      "final_value": "(2,2/e^2); y=0",
      "solution_steps": [
        "y′=e^(−x)(1−x)，y″=e^(−x)(x−2)。",
        "y″=0 得 x=2；x<2 时 y″<0，x>2 时 y″>0，变号。",
        "y(2)=2e^(−2)，拐点 (2,2e^(−2))。",
        "x→+∞ 时 xe^(−x)→0，故 y=0 是水平渐近线。"
      ],
      "key_points": [
        "乘积求导。",
        "拐点要变号。",
        "指数衰减的水平渐近线。"
      ],
      "common_errors": [
        "y″ 算成 e^(−x)(2−x)。",
        "把 x→−∞ 的无穷大当成渐近线。"
      ],
      "scope": "数学二·导数应用；x∈R。",
      "verification": {
        "method": "sympy_diff",
        "result": "PASS",
        "detail": "y″=e^-x(x-2)，拐点 x=2；y→0。"
      }
    },
