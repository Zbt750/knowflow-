# 复制为 .env 后按本机情况修改；.env 不提交进 Git。
# APP_ENV=dev 用 DATABASE_URL；APP_ENV=test 只允许 TEST_DATABASE_URL，且库名必须以 _test 结尾。
APP_ENV=dev

# 本机开发库（不要把真实密码写进 alembic.ini 或任何提交文件）
DATABASE_URL=postgresql+psycopg://kaoyan:kaoyan_dev_pw@127.0.0.1:5433/kaoyan
# 测试库；APP_ENV=test 时必填
TEST_DATABASE_URL=postgresql+psycopg://kaoyan:kaoyan_dev_pw@127.0.0.1:5433/kaoyan_test

# 学习日、毕业跨天与复测共用同一时区
TIMEZONE=Asia/Shanghai

# 存储目录（相对项目根）
UPLOAD_DIR=storage/uploads
CHROMA_DIR=storage/chroma
MODEL_CACHE_DIR=storage/models

# 摄取与检索共享的 embedding 模型
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 留空表示不启用重排
RERANKER_MODEL=

# 大模型（可选）；不配置时问答页面会明确显示“模型尚未配置”，不会伪造回答
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# 单次回答的输出上限。
# 注意：如果用的是**推理模型**（如 deepseek-flash，会先输出 reasoning_content），
# 思考过程与正文共享这个预算。实测 800 会让长 prompt 下的正文被思考挤空
# （表现为「回答生成失败」或回答被截断），因此默认取 4000。
LLM_MAX_OUTPUT_TOKENS=4000
# 首轮失败时改用这个更大预算再试一次（空回答的主因就是预算不够）。
LLM_RETRY_MAX_OUTPUT_TOKENS=8000