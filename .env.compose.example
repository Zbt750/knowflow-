# 复制成 .env.compose 后改成自己的值，再执行：
#   docker compose --env-file .env.compose up --build
# .env.compose 已在 .gitignore 中，绝不要提交真实密码。

POSTGRES_USER=kaoyan
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=kaoyan

# 浏览器访问端口
WEB_PORT=8080

TIMEZONE=Asia/Shanghai
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=

# 离线部署保持 1；能联网时可设为 0 让容器自行下载模型。
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# 需要向量检索时设为 1（镜像会明显变大）
INSTALL_EMBED=0

# 大模型（可选，阶段 D 的问答需要）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 构建加速（可选）。留空即走官方源（deb.debian.org / pypi.org）。
# 官方源很慢时再填，例如：
#   APT_MIRROR=mirrors.aliyun.com
#   PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
APT_MIRROR=
PIP_INDEX_URL=
